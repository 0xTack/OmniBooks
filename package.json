{
  "name": "omnibooks",
  "version": "0.1.7",
  "description": "An Apple Books style bookshelf view for Obsidian, built from book notes frontmatter.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "demo": "npm run build && node scripts/build-demo.mjs",
    "check": "tsc -noEmit -skipLibCheck"
  },
  "keywords": [
    "obsidian",
    "bookshelf",
    "apple-books"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.2",
    "obsidian": "^1.7.2",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2"
  }
}
